# Copy to .env and fill in. Never share or commit .env.
# GMGN (gmgn.ai/ai): required. The same key Launch Radar uses; this program spends about 20% of its plan.
GMGN_API_KEY=
# Telegram: token from @BotFather, your chat id. Without these, calls are printed to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Telegram settings (defaults in config.yaml)
TELEGRAM_THREAD_ID=
TELEGRAM_SILENT_UPDATES=
TELEGRAM_DAILY_SUMMARY_UTC=
# The dashboard password: needed on the VPS, and on this PC for tools\sync_research.py / tools\retrain.py
DASHBOARD_PASSWORD=
# Optional overrides (defaults in config.yaml)
CALL_MIN_SCORE=
CALLS_PER_DAY=
MCAP_MIN_USD=
MCAP_MAX_USD=
AUTO_RETRAIN=
GMGN_WEIGHT_PER_SEC=
GMGN_BUDGET=
# VPS only, optional: another DNS name for the dashboard (default: the Hostinger hostname, under /gems/)
DOMAIN=
